# ==============================================================================
# ShelfSync Environment Variables
# Copy this file to .env and fill in your real service credentials.
# NEVER commit .env or hardcode secrets in source files.
# ==============================================================================

# Server & App URLs
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Authentication & Session Security (use long random 32+ char strings in prod)
JWT_SECRET="change-me-to-a-secure-64-char-random-jwt-secret"
SESSION_SECRET="change-me-to-a-secure-64-char-random-session-secret"

# ==============================================================================
# 1. Aiven PostgreSQL (Required for production database persistence)
# Format: postgres://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require
# ==============================================================================
DATABASE_URL=""
PG_CA_CERT=""
PG_SSL_REJECT_UNAUTHORIZED="false"

# ==============================================================================
# 2. Aiven Apache Kafka (Event Streaming: order-placed, inventory-updated, etc.)
# Supports SASL_SSL (username/password + CA cert) or SSL mTLS
# ==============================================================================
KAFKA_BROKERS=""
KAFKA_USERNAME=""
KAFKA_PASSWORD=""
KAFKA_CA_CERT=""
KAFKA_CLIENT_ID="shelfsync-backend"
KAFKA_GROUP_ID="shelfsync-workers"

# ==============================================================================
# 3. Aiven OpenSearch (Index: shelfsync_products)
# Format: https://<host>:<port>
# ==============================================================================
OPENSEARCH_URL=""
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""
OPENSEARCH_INDEX="shelfsync_products"

# ==============================================================================
# 4. Razorpay Payment Gateway (Use Test/Sandbox keys during development)
# ==============================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ==============================================================================
# 5. Google Gemini API (ShelfSync AI Assistant product discovery & parsing)
# ==============================================================================
GEMINI_API_KEY=""

# ==============================================================================
# 6. Meta WhatsApp Business Cloud API
# ==============================================================================
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="shelfsync_whatsapp_verify_token"
WHATSAPP_APP_SECRET=""
WHATSAPP_TEMPLATE_ORDER_CONFIRMED="shelfsync_order_confirmed"
WHATSAPP_TEMPLATE_ORDER_STATUS="shelfsync_order_status"
